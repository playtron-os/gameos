FROM registry.playtron.one/internal/playtronos:1.3-stable-base

# Set OS version
COPY rootfs/usr/lib/os-release-playtron /usr/lib/

# Update packages
RUN dnf5 -y upgrade \
  gamescope-dbus-1.13.2 \
  gamescope-session-playtron-0.5.0 \
  grid-1.37.1 \
  inputplumber-0.76.0 \
  legendary-0.20.45 \
  mesa* \
  playserve-1.29.0 \
  playtron-plugin-local-1.6.1 \
  plugin-egs-1.3.0 \
  plugin-gog-1.1.3 \
  reaper-0.1.0-3.fc43 \
  SteamBus-1.27.6

# Clear cache.
RUN dnf5 clean all && \
  rm -r -f \
    /boot/.vmlinuz*.hmac \
    /var/cache/*

# View final packages.
RUN rpm -qa | sort

# View how well we adhere to bootc best practices.
RUN bootc container lint --no-truncate
