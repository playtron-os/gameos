#! /bin/bash

# Turns the generic Arm disk image into a bootable image for one specific board.

set -e

target=$1

diskimage=output/image/$target.raw

bootmnt=$(mktemp -d)
rootmnt=$(mktemp -d)

cleanup() {
	umount $bootmnt 2>/dev/null || true
	umount $rootmnt 2>/dev/null || true
	kpartx -d $diskimage
}
trap cleanup EXIT

devices=$(kpartx -av $diskimage | cut -d' ' -f3)
bootdev=$(echo "$devices" | grep p2$)
rootdev=$(echo "$devices" | grep p3$ || true)

mount /dev/mapper/$bootdev $bootmnt

# copy dtb file -- bootc-image-builder does not allow file customizations on /boot
cp arm/dtbs/$target $bootmnt/dtb

# record which board this image was customized for, so `dtb-update` knows which DTB to copy
# out of the next deployment
echo "$target" > $bootmnt/dtb.name

# Point blscfg at the per-deployment DTB.
#
# ostree writes `fdtdir` into the BLS entry, but `grubaa64.efi` has no such command -- the string
# does not appear in the binary at all -- so it is silently ignored and the board boots on the
# firmware's own device tree. On Glymur that tree lacks `dr_mode` on the USB-C controllers, the
# root disk never enumerates, and the boot dies in dracut's initqueue waiting for the root UUID.
#
# `devicetree` as a GRUB *environment variable* is the mechanism blscfg does honour: it prefixes
# the value with the directory of each entry's `linux` line, i.e. that entry's own ostree
# deployment directory. One variable covers every entry, present and future.
#
# The `devicetree ($root)/dtb` line in 70-playtron.arm64.cfg is not sufficient on its own; it is
# kept as a fallback. Without the variable below, every freshly flashed image is unbootable.
if command -v grub2-editenv >/dev/null; then
	grub2-editenv $bootmnt/grub2/grubenv set devicetree=dtb/playtron/$target
	echo "Set grubenv devicetree=dtb/playtron/$target"
else
	echo "ERROR: grub2-editenv not found; the image would not boot without the devicetree var" >&2
	exit 1
fi

umount $bootmnt

# The installer blacklists `qcom_q6v5_pas` so that the X13s can boot the installer off a USB
# device. On Glymur that same blacklist stops the ADSP and CDSP from starting, which takes out
# audio, battery reporting and USB-C, so drop it for every other board. Installed systems are
# unaffected either way -- `os-install` removes this file as part of leaving install mode.
if [ "$target" != "x13s" ]; then
	if [ -z "$rootdev" ]; then
		echo "ERROR: no root partition found in $diskimage; cannot drop the qcom_q6v5_pas blacklist" >&2
		exit 1
	fi

	mount /dev/mapper/$rootdev $rootmnt

	installer_conf=$(echo $rootmnt/root/ostree/deploy/*/deploy/*.0/etc/modprobe.d/playtron-installer.conf)
	if [ -f "$installer_conf" ]; then
		rm -f "$installer_conf"
		echo "Removed the qcom_q6v5_pas blacklist for $target"
	else
		echo "WARNING: no installer modprobe config found at $installer_conf" >&2
	fi

	umount $rootmnt
fi
